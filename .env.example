# ── model access ─────────────────────────────────────────────────────────
# Local development: a Gemini API key from https://aistudio.google.com
GOOGLE_API_KEY=

# Point the SDK at a different *Gemini* endpoint — a proxy, a regional host.
# google-genai reads this itself; nothing in this project needs to know.
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── or: any OpenAI-compatible endpoint ───────────────────────────────────
# Setting a base URL here switches the explorer to the OpenAI protocol —
# OpenRouter, a gateway, a local server. That is a different wire format from
# Gemini's, so this backend drives the browser loop itself rather than using
# ADK's native computer use. Unset it to go back to Gemini.
# CLICKWRIGHT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# The model must accept images and tool calls. stealth/ox-alpha is free on
# OpenRouter today (prompt and completion both priced at 0) — it is an
# anonymous provider evaluating traffic, so assume prompts and the screenshots
# of whatever the agent is looking at are logged.
# CLICKWRIGHT_EXPLORER_MODEL=stealth/ox-alpha

# Stop a run that is going nowhere rather than letting it spend the quota.
# CLICKWRIGHT_MAX_STEPS=40

# How the healer fixes a broken connector. "step" patches only the broken step
# (smallest reviewable diff); "full" rebuilds the playbook from a fresh run;
# "auto" patches once, then escalates to a full rebuild if an already-healed
# version breaks again.
# CLICKWRIGHT_HEAL_STRATEGY=auto

# The free tier allows 15 requests a minute, and one computer-use step is one
# request, so a long task waits rather than fails. Raise if you have a paid key.
# CLICKWRIGHT_MODEL_RETRIES=8
# How many past frames the model still sees. More context, more input tokens.
# CLICKWRIGHT_LIVE_SCREENSHOTS=2

# Deployed: use Vertex AI on the project instead of a key
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini 3.5 or newer is required by the challenge. Computer use is GA on both
# gemini-3.5-flash and gemini-3.7-flash; 3.5-flash is the cheaper default.
CLICKWRIGHT_EXPLORER_MODEL=gemini-3.5-flash
CLICKWRIGHT_DISTILLER_MODEL=gemini-3.5-flash
CLICKWRIGHT_CONSUMER_MODEL=gemini-3.5-flash

# ── services ─────────────────────────────────────────────────────────────
CLICKWRIGHT_RUNTIME_URL=http://localhost:8080
CLICKWRIGHT_HOME=var
CORS_ORIGINS=http://localhost:5173

# ── scope ────────────────────────────────────────────────────────────────
# Each connector is scoped to the host it was compiled against. This is an
# additional ceiling over all of them — leave empty to allow any host the
# operator names, set it in shared deployments so a connector cannot widen
# its own reach. Comma-separated; a leading dot covers subdomains.
# TARGET_ALLOWED_HOSTS=.example.com,supplier-portal.example.com

# ── target credentials ───────────────────────────────────────────────────
# Normally supplied through the console, which writes them to Secret Manager
# (or an owner-only var/secrets.json locally). These env vars are the manual
# equivalent, named {connector_id_with_underscores}_{username|password}.
# They are injected into the browser and never reach model context.
VENDOR_PORTAL_USERNAME=demo-user
VENDOR_PORTAL_PASSWORD=demo-pass
# The bundled portal is reached at localhost:8081, so its connector id — and
# therefore its variable prefix — is LOCALHOST, not VENDOR_PORTAL.
LOCALHOST_USERNAME=demo-user
LOCALHOST_PASSWORD=demo-pass
BENEFITS_PORTAL_USERNAME=benefits-user
BENEFITS_PORTAL_PASSWORD=demo-pass

# Set to 1 on the target to simulate a redesign and trigger the healer
DRIFT=0
# Set to 1 to watch the browser instead of running headless
HEADFUL=0
